     "1660년 송준길(宋浚吉) 납폐서(納幣書) (1660)"
    ]
   },
   "width": 1400,
   "height": 810,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1660"
      ]
