   "label": {
    "ko": [
     "양아록(養兒錄) — 손자가 태어난 날의 시 (1551)"
    ]
   },
   "width": 1400,
   "height": 1006,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1551"
      ]
     }
    },
    {
     "label": {
      "ko": [
