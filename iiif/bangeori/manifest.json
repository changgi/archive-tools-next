    "ko": [
     "동계절목책(洞契節目冊)"
    ]
   },
   "width": 1400,
   "height": 1165,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "미상"
      ]
     }
    },
    {
     "label": {
      "ko": [
       "문서 유형"
      ]
