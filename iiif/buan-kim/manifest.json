   "type": "Canvas",
   "label": {
    "ko": [
     "1600년 김홍원에게 내린 국왕의 명령서 (1600)"
    ]
   },
   "width": 1336,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1600"
      ]
     }
    },
    {
