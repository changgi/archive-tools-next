    "ko": [
     "1712년 승(僧) 수담(守淡) 토지매매명문(土地賣買明文) (1712)"
    ]
   },
   "width": 1309,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
