   "type": "Canvas",
   "label": {
    "ko": [
     "1545년 이언적 유지－1 (1545)"
    ]
   },
   "width": 1034,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1545"
      ]
