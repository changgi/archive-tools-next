   "label": {
    "ko": [
     "1714년 오수웅(吳遂雄) 유서(諭書) (1714)"
    ]
   },
   "width": 1400,
   "height": 738,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1714"
      ]
