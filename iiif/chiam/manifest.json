   "label": {
    "ko": [
     "1783년 이희모(李希謨) 소지(所志) (1783)"
    ]
   },
   "width": 965,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1783"
      ]
