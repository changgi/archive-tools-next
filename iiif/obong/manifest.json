    "ko": [
     "1617년 광해군(光海君) 교서(敎書) (1617)"
    ]
   },
   "width": 1400,
   "height": 949,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1617"
      ]
