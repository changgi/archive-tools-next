   "label": {
    "ko": [
     "1862년 오영선(吳永善) 유서(諭書) (1862)"
    ]
   },
   "width": 1400,
   "height": 900,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1862"
      ]
