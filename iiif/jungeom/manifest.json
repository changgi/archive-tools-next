    "ko": [
     "1901년 중엄동중(中嚴洞中) 신당구기가거문(神塘舊基可據文) (1901)"
    ]
   },
   "width": 1400,
   "height": 934,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1901"
      ]
     }
    },
    {
