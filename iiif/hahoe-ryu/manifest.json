   "label": {
    "ko": [
     "1596년 유성룡(柳成龍) 비답(批答)－1 (1596)"
    ]
   },
   "width": 971,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1596"
      ]
