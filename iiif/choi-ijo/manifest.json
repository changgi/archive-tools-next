   "type": "Canvas",
   "label": {
    "ko": [
     "1633년 최진립(崔震立) 교서(敎書) (1633)"
    ]
   },
   "width": 1400,
   "height": 515,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1633"
      ]
