   "label": {
    "ko": [
     "1791년 은계 찰방 강봉서(姜鳳瑞)에게 내린 유지(有旨) (1791)"
    ]
   },
   "width": 1018,
   "height": 680,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
