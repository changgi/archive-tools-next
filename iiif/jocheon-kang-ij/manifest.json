   "type": "Canvas",
   "label": {
    "ko": [
     "1888년 강 영장 댁 노 달석 소지(所志) — 목장 안 선산 (1888)"
    ]
   },
   "width": 890,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1888"
      ]
     }
    },
    {
     "label": {
      "ko": [
