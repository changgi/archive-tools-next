   "type": "Canvas",
   "label": {
    "ko": [
     "1759년 속오군(束伍軍) 김천세(金千世), 박여달(朴汝達), 이필(李怭) 등 등장(等狀) (1759)"
    ]
   },
   "width": 962,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1759"
      ]
     }
    },
    {
     "label": {
      "ko": [
