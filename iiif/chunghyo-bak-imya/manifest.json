    "ko": [
     "국유산양여원(國有山讓與願)－1 (1913)"
    ]
   },
   "width": 1400,
   "height": 1189,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1913"
      ]
