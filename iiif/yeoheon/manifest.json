    "ko": [
     "1623년 장현광(張顯光) 노(奴) 애남(愛男) 소지(所志)－2 (1623)"
    ]
   },
   "width": 1165,
   "height": 1400,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1623"
