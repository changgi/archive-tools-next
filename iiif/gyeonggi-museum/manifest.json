     "1692년 송규렴이 ‘긔튝이’에게 보낸 편지 (1692)"
    ]
   },
   "width": 1400,
   "height": 991,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1692"
      ]
