   "label": {
    "ko": [
     "1825년 정익환(鄭益煥) 별급문(別給文) (1825)"
    ]
   },
   "width": 1400,
   "height": 937,
   "metadata": [
    {
     "label": {
      "ko": [
       "연도"
      ]
     },
     "value": {
      "ko": [
       "1825"
      ]
     }
    },
    {
     "label": {
      "ko": [
